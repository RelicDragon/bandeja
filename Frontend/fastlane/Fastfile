# frozen_string_literal: true

default_platform(:android)

ANDROID_PACKAGE = "com.funified.bandeja"
IOS_APP_IDENTIFIER = "com.funified.bandeja"

def play_json_key_path
  path = ENV["PLAY_STORE_JSON_KEY_PATH"] || ENV["GOOGLE_PLAY_JSON_KEY"]
  UI.user_error!("Set PLAY_STORE_JSON_KEY_PATH or GOOGLE_PLAY_JSON_KEY to your Play service account JSON file") if path.nil? || path.empty?
  UI.user_error!("Play service account JSON not found at #{path}") unless File.exist?(path)
  path
end

def play_supply_config(track)
  require "supply"
  require "supply/options"

  FastlaneCore::Configuration.create(
    Supply::Options.available_options,
    {
      package_name: ANDROID_PACKAGE,
      track: track,
      json_key: play_json_key_path
    }
  )
end

def verify_play_release!(track, version_code, expected_changelog)
  require "supply/reader"

  Supply.config = play_supply_config(track)
  version_codes = Supply::Reader.new.track_version_codes.map(&:to_s)
  unless version_codes.include?(version_code)
    UI.user_error!(
      "Google Play track #{track} does not include version code #{version_code}; " \
      "found #{version_codes.empty? ? 'none' : version_codes.join(', ')}"
    )
  end

  Supply.config = play_supply_config(track)
  track_meta = Supply::Reader.new.track_meta
  release = track_meta&.releases&.find do |candidate|
    Array(candidate.version_codes).map(&:to_s).include?(version_code)
  end
  UI.user_error!("Google Play track #{track} has no release for version code #{version_code}") unless release

  notes = Array(release.release_notes).find do |note|
    note.language == "en-US"
  end
  UI.user_error!("Google Play release #{version_code} is missing en-US release notes") unless notes

  if !expected_changelog.to_s.strip.empty? && notes.text.to_s.strip != expected_changelog.to_s.strip
    UI.user_error!("Google Play en-US release notes do not match the planned changelog")
  end

  UI.success("Verified Google Play #{track} release #{version_code}: version code and en-US notes match")
end

def asc_api_key
  key_id = ENV.fetch("ASC_KEY_ID")
  issuer_id = ENV.fetch("ASC_ISSUER_ID")
  key_path = ENV.fetch("ASC_KEY_PATH")
  UI.user_error!("App Store Connect API key not found at #{key_path}") unless File.exist?(key_path)

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_path,
    duration: 1200,
    in_house: false
  )
end

def emit_ios_release_state(state)
  require "json"

  UI.message("APP_RELEASE_IOS_STATE_JSON:#{JSON.generate(state.compact)}")
end

def emit_store_review_state(state)
  require "json"

  UI.message("APP_RELEASE_REVIEW_STATE_JSON:#{JSON.generate(state.compact)}")
end

module ::AppReleaseStoreReview
  IOS_BLOCKING_REVIEW_STATES = [
    Spaceship::ConnectAPI::ReviewSubmission::ReviewSubmissionState::CANCELING,
    Spaceship::ConnectAPI::ReviewSubmission::ReviewSubmissionState::WAITING_FOR_REVIEW,
    Spaceship::ConnectAPI::ReviewSubmission::ReviewSubmissionState::IN_REVIEW,
    Spaceship::ConnectAPI::ReviewSubmission::ReviewSubmissionState::UNRESOLVED_ISSUES
  ].freeze

  def self.google_in_review_release(service)
    parent = "applications/#{ANDROID_PACKAGE}/tracks/production"
    response = service.list_application_track_releases(parent)
    Array(response.releases).find do |release|
      release.release_lifecycle_state == "RELEASE_LIFECYCLE_STATE_IN_REVIEW"
    end
  end

  def self.ios_blocking_review_submission(app, platform)
    app.get_review_submissions(
      filter: {
        state: IOS_BLOCKING_REVIEW_STATES.join(","),
        platform: platform
      },
      includes: "appStoreVersionForReview"
    ).first
  end

  def self.ios_removal_complete?(submission)
    submission.nil? || submission.state ==
      Spaceship::ConnectAPI::ReviewSubmission::ReviewSubmissionState::COMPLETE
  end
end

# Supply does not expose Android Publisher's changesInReviewBehavior option yet.
# Make production commits explicit: fail on an unexpected review, or replace it
# only after the release CLI has recorded the user's consent.
def install_explicit_google_review_commit!
  require "supply/client"
  return if Supply::Client.method_defined?(:app_release_original_commit_current_edit!)

  Supply::Client.class_eval do
    alias_method :app_release_original_commit_current_edit!, :commit_current_edit!

    def commit_current_edit!
      behavior = ENV["APP_RELEASE_GOOGLE_REVIEW_BEHAVIOR"]
      return app_release_original_commit_current_edit! if behavior.nil? || behavior.empty?

      send(:ensure_active_edit!)
      if behavior == "CANCEL_IN_REVIEW_AND_SUBMIT"
        reviewed_release = AppReleaseStoreReview.google_in_review_release(client)
        expected_version_code = ENV["APP_RELEASE_GOOGLE_EXPECTED_REVIEW_VERSION_CODE"].to_s
        expected_version_codes = ENV["APP_RELEASE_GOOGLE_EXPECTED_REVIEW_VERSION_CODES"].to_s
          .split(",").reject(&:empty?).uniq.sort_by(&:to_i)
        expected_version = ENV["APP_RELEASE_GOOGLE_EXPECTED_REVIEW_VERSION"].to_s
        actual_version_codes = Array(reviewed_release&.active_artifacts).map do |artifact|
          artifact.version_code.to_s
        end.uniq.sort_by(&:to_i)
        version_matches = expected_version.empty? ||
          reviewed_release&.release_name.to_s == expected_version
        identity_matches = if !expected_version_codes.empty?
                             reviewed_release && version_matches &&
                               actual_version_codes == expected_version_codes
                           elsif expected_version_code.empty?
                             reviewed_release && !expected_version.empty? &&
                               reviewed_release.release_name.to_s == expected_version
                           else
                             reviewed_release && version_matches &&
                               actual_version_codes.include?(expected_version_code)
                           end

        if reviewed_release.nil?
          # The approved review finished while the AAB was uploading. Commit normally,
          # but retain the atomic guard against a different review appearing now.
          behavior = "ERROR_IF_IN_REVIEW"
        elsif !identity_matches
          conflict_message =
            "APP_RELEASE_GOOGLE_REVIEW_CONFLICT: The production review changed after approval; " \
            "expected version=#{expected_version.empty? ? 'unknown' : expected_version}, " \
            "versionCode=#{expected_version_code.empty? ? 'unknown' : expected_version_code}"
          abort_current_edit
          UI.user_error!(
            conflict_message
          )
        end
      end

      send(:call_google_api) do
        client.commit_edit(
          current_package_name,
          current_edit.id,
          changes_in_review_behavior: behavior
        )
      end
      self.current_edit = nil
      self.current_package_name = nil
    end
  end
end

def google_production_review_state
  require "supply/client"

  Supply.config = play_supply_config("production")
  supply_client = Supply::Client.make_from_config(params: Supply.config)
  reviewed_release = AppReleaseStoreReview.google_in_review_release(supply_client.client)

  if reviewed_release
    version_codes = Array(reviewed_release.active_artifacts).map do |artifact|
      artifact.version_code.to_s
    end.uniq.sort_by(&:to_i)
    {
      "platform" => "android",
      "inReview" => true,
      "state" => reviewed_release.release_lifecycle_state,
      "version" => reviewed_release.release_name,
      "versionCode" => version_codes.max_by(&:to_i),
      "versionCodes" => version_codes
    }
  else
    {
      "platform" => "android",
      "inReview" => false
    }
  end
end

def ios_blocking_review_submission
  asc_api_key
  app = Spaceship::ConnectAPI::App.find(IOS_APP_IDENTIFIER)
  UI.user_error!("Could not find App Store Connect app #{IOS_APP_IDENTIFIER}") unless app

  platform = Spaceship::ConnectAPI::Platform.map("ios")
  AppReleaseStoreReview.ios_blocking_review_submission(app, platform)
end

def guard_no_ios_blocking_review!(phase)
  pending_review = ios_blocking_review_submission
  return unless pending_review

  UI.user_error!(
    "APP_RELEASE_IOS_REVIEW_CONFLICT:#{pending_review.id} " \
    "An App Store review submission appeared #{phase}"
  )
end

def ios_release_state(app_store_version: nil, build: nil, last_observed_processing_status: nil, metadata_updated_at: nil)
  submission = app_store_version&.app_store_version_submission
  {
    "appStoreVersionId" => app_store_version&.id,
    "buildId" => build&.id,
    "lastObservedProcessingStatus" => last_observed_processing_status || build&.processing_state,
    "metadataUpdatedAt" => metadata_updated_at,
    "submissionId" => submission&.id
  }
end

def ios_binary_already_uploaded?(error)
  message = error.to_s
  message.match?(/already (been )?uploaded/i) ||
    message.match?(/binary.*already exists/i) ||
    message.match?(/redundant binary upload/i) ||
    message.match?(/build.*already exists/i) ||
    message.match?(/already uploaded a build/i) ||
    message.match?(/build number.*already/i) ||
    message.match?(/uploaded.*build.*already/i)
end

def find_ios_app_store_build(app_version, build_number)
  asc_api_key
  app = Spaceship::ConnectAPI::App.find(IOS_APP_IDENTIFIER)
  UI.user_error!("Could not find App Store Connect app #{IOS_APP_IDENTIFIER}") unless app

  platform = Spaceship::ConnectAPI::Platform.map("ios")
  builds = Spaceship::ConnectAPI::Build.all(
    app_id: app.id,
    version: app_version,
    build_number: build_number,
    platform: platform,
    processing_states: "PROCESSING,FAILED,INVALID,VALID",
    sort: "-uploadedDate",
    limit: 10
  )

  builds.find do |build|
    build.app_version == app_version && build.version.to_s == build_number
  end
end

def exact_ios_build_selectable?(build)
  build&.processing_state == Spaceship::ConnectAPI::Build::ProcessingState::VALID
end

def ios_build_audience_type(build)
  return nil unless build&.id

  resp = Spaceship::ConnectAPI.client.get_build(build_id: build.id)
  resp.body.dig("data", "attributes", "buildAudienceType")
rescue StandardError
  nil
end

def assert_exact_ios_build_selectable!(app_version, build_number)
  build = find_ios_app_store_build(app_version, build_number)
  UI.user_error!("Exact App Store Connect build #{app_version} (#{build_number}) is not visible yet.") unless build

  unless exact_ios_build_selectable?(build)
    UI.user_error!(
      "Exact App Store Connect build #{app_version} (#{build_number}) is #{build.processing_state}; " \
      "cannot continue until that build is VALID and selectable."
    )
  end

  audience = ios_build_audience_type(build)
  if audience && audience != "APP_STORE_ELIGIBLE"
    UI.user_error!(
      "App Store Connect build #{app_version} (#{build_number}) has buildAudienceType=#{audience}; " \
      "only APP_STORE_ELIGIBLE builds can be attached to an App Store version " \
      "(INTERNAL_ONLY / TestFlight-internal uploads cannot be submitted)."
    )
  end

  build
end

IOS_STORE_VERSION_BUILD_ATTACHABLE_STATES = [
  Spaceship::ConnectAPI::AppStoreVersion::AppVersionState::PREPARE_FOR_SUBMISSION,
  Spaceship::ConnectAPI::AppStoreVersion::AppVersionState::DEVELOPER_REJECTED,
  Spaceship::ConnectAPI::AppStoreVersion::AppVersionState::REJECTED,
  Spaceship::ConnectAPI::AppStoreVersion::AppVersionState::METADATA_REJECTED,
  Spaceship::ConnectAPI::AppStoreVersion::AppVersionState::INVALID_BINARY
].freeze

def assert_ios_store_version_accepts_build!(app_version, build_number)
  app_store_version = find_ios_app_store_version(app_version)
  return nil unless app_store_version

  state = app_store_version.app_version_state
  return app_store_version if IOS_STORE_VERSION_BUILD_ATTACHABLE_STATES.include?(state)

  selected = app_store_version.get_build
  selected_label = selected ? "#{selected.version}" : "none"
  UI.user_error!(
    "App Store Connect version #{app_version} is #{state} (selected build #{selected_label}) and cannot " \
    "accept build #{build_number}. Live/approved versions need a new marketing version " \
    "(e.g. bump past #{app_version}), rebuild, then upload again. " \
    "ASC error if ignored: 'The specified pre-release build could not be added'."
  )
end

def find_ios_app_store_version(app_version)
  asc_api_key
  app = Spaceship::ConnectAPI::App.find(IOS_APP_IDENTIFIER)
  UI.user_error!("Could not find App Store Connect app #{IOS_APP_IDENTIFIER}") unless app

  platform = Spaceship::ConnectAPI::Platform.map("ios")
  versions = app.get_app_store_versions(
    filter: {
      versionString: app_version,
      platform: platform
    },
    includes: "appStoreVersionLocalizations,appStoreVersionSubmission",
    limit: 10
  )

  versions.find do |version|
    version.version_string == app_version
  end
end

def ios_app_store_version_submitted?(app_store_version)
  submitted_states = [
    Spaceship::ConnectAPI::AppStoreVersion::AppVersionState::WAITING_FOR_EXPORT_COMPLIANCE,
    Spaceship::ConnectAPI::AppStoreVersion::AppVersionState::WAITING_FOR_REVIEW,
    Spaceship::ConnectAPI::AppStoreVersion::AppVersionState::IN_REVIEW,
    Spaceship::ConnectAPI::AppStoreVersion::AppVersionState::PENDING_APPLE_RELEASE,
    Spaceship::ConnectAPI::AppStoreVersion::AppVersionState::PENDING_DEVELOPER_RELEASE
  ]

  !app_store_version.app_store_version_submission.nil? ||
    submitted_states.include?(app_store_version.app_version_state)
end

def verify_ios_store_version_metadata!(app_version, build_number, expected_release_notes, expected_submit_for_review)
  app_store_version = find_ios_app_store_version(app_version)
  UI.user_error!("Could not find App Store Connect version #{app_version} for #{IOS_APP_IDENTIFIER}") unless app_store_version

  localizations = app_store_version.get_app_store_version_localizations
  en_us = localizations.find do |localization|
    localization.locale == "en-US"
  end

  UI.user_error!("App Store Connect version #{app_version} is missing en-US localization") unless en_us
  UI.user_error!("App Store Connect version #{app_version} is missing en-US whatsNew") if en_us.whats_new.to_s.strip.empty?

  if !expected_release_notes.to_s.strip.empty? && en_us.whats_new.to_s.strip != expected_release_notes.to_s.strip
    UI.user_error!("App Store Connect en-US whatsNew does not match the planned release notes")
  end

  selected_build = app_store_version.get_build
  UI.user_error!("App Store Connect version #{app_version} has no selected build") unless selected_build

  if selected_build.version.to_s != build_number
    UI.user_error!(
      "App Store Connect selected build is #{selected_build.version}; expected #{build_number}"
    )
  end

  submitted = ios_app_store_version_submitted?(app_store_version)
  if expected_submit_for_review && !submitted
    UI.user_error!("App Store Connect submit-for-review was requested but is not visible after finalizing")
  end

  if !expected_submit_for_review && submitted
    UI.user_error!("App Store Connect version appears submitted for review, but prepare-without-submit mode was selected")
  end

  emit_ios_release_state(
    ios_release_state(
      app_store_version: app_store_version,
      build: selected_build
    )
  )

  UI.success(
    "Verified App Store Connect metadata for #{app_version} (#{build_number}): " \
    "en-US whatsNew present, selected build matches, submit-for-review=#{submitted}"
  )
end

platform :android do
  desc "Detect whether Google Play already has production changes in review"
  lane :review_status do
    emit_store_review_state(google_production_review_state)
  end

  desc "Upload signed AAB to Google Play with en-US What's new"
  lane :upload_release do |options|
    aab = options[:aab]
    track = options[:track] || "internal"
    metadata_path = options[:metadata_path]

    UI.user_error!("aab path is required") if aab.nil? || aab.empty?
    UI.user_error!("metadata_path is required") if metadata_path.nil? || metadata_path.empty?
    UI.user_error!("AAB not found at #{aab}") unless File.exist?(aab)

    install_explicit_google_review_commit!
    previous_behavior = ENV["APP_RELEASE_GOOGLE_REVIEW_BEHAVIOR"]
    previous_expected_version_code = ENV["APP_RELEASE_GOOGLE_EXPECTED_REVIEW_VERSION_CODE"]
    previous_expected_version_codes = ENV["APP_RELEASE_GOOGLE_EXPECTED_REVIEW_VERSION_CODES"]
    previous_expected_version = ENV["APP_RELEASE_GOOGLE_EXPECTED_REVIEW_VERSION"]
    ENV["APP_RELEASE_GOOGLE_REVIEW_BEHAVIOR"] =
      options[:replace_existing_review].to_s == "true" ?
        "CANCEL_IN_REVIEW_AND_SUBMIT" : "ERROR_IF_IN_REVIEW"
    ENV["APP_RELEASE_GOOGLE_EXPECTED_REVIEW_VERSION_CODE"] =
      options[:expected_review_version_code].to_s
    ENV["APP_RELEASE_GOOGLE_EXPECTED_REVIEW_VERSION_CODES"] =
      options[:expected_review_version_codes].to_s
    ENV["APP_RELEASE_GOOGLE_EXPECTED_REVIEW_VERSION"] = options[:expected_review_version].to_s

    begin
      upload_to_play_store(
        package_name: ANDROID_PACKAGE,
        aab: aab,
        track: track,
        json_key: play_json_key_path,
        skip_upload_apk: true,
        skip_upload_metadata: true,
        skip_upload_changelogs: false,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        metadata_path: metadata_path
      )
    ensure
      if previous_behavior
        ENV["APP_RELEASE_GOOGLE_REVIEW_BEHAVIOR"] = previous_behavior
      else
        ENV.delete("APP_RELEASE_GOOGLE_REVIEW_BEHAVIOR")
      end
      if previous_expected_version_code
        ENV["APP_RELEASE_GOOGLE_EXPECTED_REVIEW_VERSION_CODE"] = previous_expected_version_code
      else
        ENV.delete("APP_RELEASE_GOOGLE_EXPECTED_REVIEW_VERSION_CODE")
      end
      if previous_expected_version_codes
        ENV["APP_RELEASE_GOOGLE_EXPECTED_REVIEW_VERSION_CODES"] = previous_expected_version_codes
      else
        ENV.delete("APP_RELEASE_GOOGLE_EXPECTED_REVIEW_VERSION_CODES")
      end
      if previous_expected_version
        ENV["APP_RELEASE_GOOGLE_EXPECTED_REVIEW_VERSION"] = previous_expected_version
      else
        ENV.delete("APP_RELEASE_GOOGLE_EXPECTED_REVIEW_VERSION")
      end
    end
  end

  desc "Verify Google Play release after upload"
  lane :verify_release do |options|
    track = options[:track] || "internal"
    version_code = options[:version_code].to_s
    changelog_path = options[:changelog_path]

    UI.user_error!("version_code is required") if version_code.empty?
    UI.user_error!("changelog_path is required") if changelog_path.nil? || changelog_path.empty?
    UI.user_error!("Google Play changelog not found at #{changelog_path}") unless File.exist?(changelog_path)

    verify_play_release!(track, version_code, File.read(changelog_path))
  end
end

platform :ios do
  desc "Detect whether App Store Connect already has an iOS submission in review"
  lane :review_status do
    submission = ios_blocking_review_submission
    version = submission&.app_store_version_for_review
    emit_store_review_state(
      {
        "platform" => "ios",
        "inReview" => !submission.nil?,
        "state" => submission&.state,
        "version" => version&.version_string,
        "submissionId" => submission&.id
      }
    )
  end

  desc "Remove an explicitly approved iOS submission from App Review"
  lane :remove_from_review do |options|
    requested_submission_id = options[:submission_id].to_s
    UI.user_error!("submission_id is required") if requested_submission_id.empty?

    submission = ios_blocking_review_submission
    if submission.nil?
      UI.success("No App Store review submission remains to remove")
      next
    end
    if submission.id != requested_submission_id
      UI.user_error!(
        "App Store review submission changed from #{requested_submission_id} to #{submission.id}; " \
        "run the release planner again to approve the current submission"
      )
    end

    submission.cancel_submission unless submission.state ==
      Spaceship::ConnectAPI::ReviewSubmission::ReviewSubmissionState::CANCELING
    interval_seconds = (ENV["APP_RELEASE_IOS_REVIEW_CANCEL_INTERVAL"] || "15").to_i
    timeout_seconds = (ENV["APP_RELEASE_IOS_REVIEW_CANCEL_TIMEOUT"] || "600").to_i
    deadline = Time.now + timeout_seconds

    loop do
      remaining = Spaceship::ConnectAPI::ReviewSubmission.get(
        review_submission_id: requested_submission_id
      )
      break if AppReleaseStoreReview.ios_removal_complete?(remaining)
      if Time.now >= deadline
        UI.user_error!(
          "Timed out waiting for App Store review submission #{requested_submission_id} to be removed"
        )
      end
      UI.message("Waiting for App Store review removal to finish...")
      sleep(interval_seconds)
    end

    UI.success("Removed App Store review submission #{requested_submission_id}")
  end

  desc "Upload IPA binary to App Store Connect"
  lane :upload_binary do |options|
    ipa = options[:ipa]

    UI.user_error!("ipa path is required") if ipa.nil? || ipa.empty?
    UI.user_error!("IPA not found at #{ipa}") unless File.exist?(ipa)

    if options[:guard_no_review].to_s == "true"
      guard_no_ios_blocking_review!("before binary upload")
    end

    base_options = {
      api_key: asc_api_key,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false
    }

    begin
      upload_to_app_store(
        **base_options,
        ipa: ipa,
        skip_metadata: true,
        skip_binary_upload: false,
        submit_for_review: false
      )
    rescue => error
      raise error unless ios_binary_already_uploaded?(error)

      UI.important("IPA already appears to be uploaded; continuing with App Store processing wait")
    end
  end

  desc "Wait until App Store Connect has processed the exact uploaded iOS build"
  lane :wait_for_processed_ios_build do |options|
    app_version = options[:app_version].to_s
    build_number = options[:build_number].to_s
    interval_seconds = (options[:interval_seconds] || ENV["APP_RELEASE_IOS_WAIT_INTERVAL"] || "60").to_i
    timeout_seconds = (options[:timeout_seconds] || ENV["APP_RELEASE_IOS_WAIT_TIMEOUT"] || "1800").to_i
    deadline = Time.now + timeout_seconds

    UI.user_error!("app_version is required") if app_version.empty?
    UI.user_error!("build_number is required") if build_number.empty?

    loop do
      build = find_ios_app_store_build(app_version, build_number)
      observed_state = build ? build.processing_state : "not visible"
      emit_ios_release_state(
        ios_release_state(
          build: build,
          last_observed_processing_status: observed_state
        )
      )

      if exact_ios_build_selectable?(build)
        UI.success("App Store Connect build #{app_version} (#{build_number}) is processed and selectable")
        break
      end

      if build && [Spaceship::ConnectAPI::Build::ProcessingState::FAILED, Spaceship::ConnectAPI::Build::ProcessingState::INVALID].include?(build.processing_state)
        UI.user_error!(
          "Exact App Store Connect build #{app_version} (#{build_number}) is #{build.processing_state}; " \
          "cannot continue with this build."
        )
      end

      if Time.now >= deadline
        UI.user_error!(
          "IPA upload completed, but App Store Connect has not made exact build " \
          "#{app_version} (#{build_number}) selectable yet. Current state: #{observed_state}. " \
          "Resume later with APP_RELEASE_RESUME=1 ./scripts/app-release.sh; resume will skip " \
          "IPA upload and continue with metadata/submission."
        )
      end

      UI.message(
        "Waiting for exact App Store Connect build #{app_version} (#{build_number}) to become selectable; " \
        "current state is #{observed_state}. Checking again in #{interval_seconds}s."
      )
      sleep(interval_seconds)
    end
  end

  desc "Update App Store version metadata and optionally submit for review"
  lane :finalize_store_version do |options|
    release_notes_path = options[:release_notes_path]
    app_version = options[:app_version].to_s
    build_number = options[:build_number].to_s
    submit_for_review = options[:submit_for_review].to_s == "true"

    UI.user_error!("release_notes_path is required") if release_notes_path.nil? || release_notes_path.empty?
    UI.user_error!("app_version is required") if app_version.empty?
    UI.user_error!("build_number is required") if build_number.empty?
    UI.user_error!("Release notes file not found at #{release_notes_path}") unless File.exist?(release_notes_path)

    if submit_for_review
      guard_no_ios_blocking_review!("before final submission")
    end

    assert_exact_ios_build_selectable!(app_version, build_number)
    assert_ios_store_version_accepts_build!(app_version, build_number)
    release_notes = File.read(release_notes_path)

    upload_to_app_store(
      api_key: asc_api_key,
      app_version: app_version,
      build_number: build_number,
      skip_metadata: false,
      skip_screenshots: true,
      skip_binary_upload: true,
      submit_for_review: submit_for_review,
      force: true,
      precheck_include_in_app_purchases: false,
      release_notes: {
        "default" => release_notes,
        "en-US" => release_notes
      }
    )

    require "time"
    app_store_version = find_ios_app_store_version(app_version)
    selected_build = app_store_version&.get_build
    emit_ios_release_state(
      ios_release_state(
        app_store_version: app_store_version,
        build: selected_build,
        metadata_updated_at: Time.now.utc.iso8601
      )
    )
  end

  desc "Verify App Store version metadata after finalizing"
  lane :verify_store_version do |options|
    release_notes_path = options[:release_notes_path]
    app_version = options[:app_version].to_s
    build_number = options[:build_number].to_s
    expected_submit_for_review = options[:expected_submit_for_review].to_s == "true"

    UI.user_error!("release_notes_path is required") if release_notes_path.nil? || release_notes_path.empty?
    UI.user_error!("app_version is required") if app_version.empty?
    UI.user_error!("build_number is required") if build_number.empty?
    UI.user_error!("Release notes file not found at #{release_notes_path}") unless File.exist?(release_notes_path)

    verify_ios_store_version_metadata!(
      app_version,
      build_number,
      File.read(release_notes_path),
      expected_submit_for_review
    )
  end

  desc "Upload IPA, wait for processing, update metadata, and optionally submit for review"
  lane :upload_release do |options|
    ipa = options[:ipa]
    release_notes_path = options[:release_notes_path]
    app_version = options[:app_version]
    build_number = options[:build_number]
    submit_for_review = options[:submit_for_review]

    upload_binary(ipa: ipa)
    wait_for_processed_ios_build(app_version: app_version, build_number: build_number)
    finalize_store_version(
      release_notes_path: release_notes_path,
      app_version: app_version,
      build_number: build_number,
      submit_for_review: submit_for_review
    )
    verify_store_version(
      release_notes_path: release_notes_path,
      app_version: app_version,
      build_number: build_number,
      expected_submit_for_review: submit_for_review
    )
  end
end
