{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "Backend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "Frontend",
        "run",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "Frontend",
        "run",
        "dev",
        "--",
        "--port",
        "3011",
        "--strictPort"
      ],
      "port": 3011
    },
    {
      "name": "roster-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "9123",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs/plans/game-roster-redesign"
      ],
      "port": 9123
    }
  ]
}
